# Copie para deploy/.env.prod (nunca versionar). Gere segredos fortes: openssl rand -base64 48
DOMAIN=portaria.exemplo.com.br
ACME_EMAIL=ops@exemplo.com.br
# Somente para teste local com portas não padrão (ex.: ":8443"); em produção deixe vazio
PUBLIC_PORT_SUFFIX=
HTTP_PORT=80
HTTPS_PORT=443

DB_PASSWORD=
CREDENTIAL_HMAC_SECRET=
AGENT_POLICY_MASTER_SECRET=
# Criptografia de dados pessoais: "id:base64(32 bytes)" (gere com: openssl rand -base64 32). Guarde FORA do backup do banco.
FIELD_ENCRYPTION_KEYS=
FIELD_ENCRYPTION_ACTIVE_KEY_ID=
BLIND_INDEX_KEY=
KEYCLOAK_ADMIN=
KEYCLOAK_ADMIN_PASSWORD=
GRAFANA_PASSWORD=

# Hosts de controladoras HTTP que a central pode contatar (separados por vírgula; vazio = nenhum)
DEVICE_HTTP_ALLOWED_HOSTS=

# Só na instalação inicial: sub (id) do usuário criado no Keycloak que será o primeiro administrador da plataforma.
# Depois de criado, REMOVA estas duas linhas.
BOOTSTRAP_PLATFORM_ADMIN_SUBJECT=
BOOTSTRAP_PLATFORM_ADMIN_EMAIL=
