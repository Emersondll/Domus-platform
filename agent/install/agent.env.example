# Copie para /etc/portaria-agent/agent.env (chmod 600). NUNCA versione o arquivo real.
PORTARIA_CENTRAL_URL=https://central.exemplo.com.br
PORTARIA_AGENT_ID=<id recebido no cadastro do agente>
PORTARIA_AGENT_KEY=<chave recebida no cadastro>
PORTARIA_POLICY_SECRET=<segredo da politica recebido no cadastro>
# Cifra o armazenamento local (politica, fila de eventos, chave de API). >= 32 caracteres. Guarde uma copia FORA da maquina:
# trocar ou perder esta chave impede abrir o armazenamento (o agente se recusa a iniciar e NAO apaga o arquivo).
PORTARIA_STORE_KEY=<segredo longo e aleatorio: openssl rand -hex 32>
PORTARIA_LOCAL_KEY=<chave aleatoria longa usada pelo leitor local>
PORTARIA_DATA_DIR=/var/lib/portaria-agent
PORTARIA_LOCAL_PORT=8099
PORTARIA_SYNC_SECONDS=10
PORTARIA_TIMEOUT_SECONDS=5

# Atualização automática (OPCIONAL; desligada se PORTARIA_UPDATE_URL não estiver definida).
# Exige a chave PÚBLICA de lançamento: o agente só instala jar cujo manifesto esteja assinado por ela (Ed25519).
#PORTARIA_UPDATE_URL=https://releases.exemplo.com.br/portaria-agent/
#PORTARIA_UPDATE_PUBLIC_KEY=<base64 gerado por: java -cp agent.jar br.com.portaria.agent.update.SignTool genkey ./chaves>
#PORTARIA_UPDATE_CHANNEL=stable
#PORTARIA_UPDATE_CHECK_HOURS=24
#PORTARIA_JAR_PATH=/var/lib/portaria-agent/bin/agent.jar
