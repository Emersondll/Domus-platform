{
  "realm": "portaria",
  "displayName": "Portaria Virtual",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "editUsernameAllowed": false,
  "verifyEmail": false,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "permanentLockout": false,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "minimumQuickLoginWaitSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "accessCodeLifespan": 60,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "passwordPolicy": "length(12) and notUsername and notEmail",
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "otpPolicyLookAheadWindow": 1,
  "roles": {
    "realm": [
      {
        "name": "operator",
        "description": "Papel usado apenas para exigir MFA; a autorização de negócio vem das associações da plataforma"
      },
      {
        "name": "company-admin",
        "description": "Papel usado apenas para exigir MFA; a autorização de negócio vem das associações da plataforma"
      },
      {
        "name": "platform-admin",
        "description": "Papel usado apenas para exigir MFA; a autorização de negócio vem das associações da plataforma"
      },
      {
        "name": "condo-manager",
        "description": "Papel usado apenas para exigir MFA; a autorização de negócio vem das associações da plataforma"
      },
      {
        "name": "resident",
        "description": "Papel usado apenas para exigir MFA; a autorização de negócio vem das associações da plataforma"
      }
    ]
  },
  "clients": [
    {
      "clientId": "portaria-panel",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "https://panel.*/*",
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      }
    },
    {
      "clientId": "portaria-resident",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "https://app.*/*",
        "http://localhost:5174/*"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      }
    }
  ],
  "browserFlow": "browser-mfa",
  "authenticationFlows": [
    {
      "alias": "browser-mfa",
      "description": "Login pelo navegador com OTP obrigatório para papéis de equipe",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticatorFlow": true,
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "flowAlias": "browser-mfa-forms",
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "browser-mfa-forms",
      "description": "Usuário e senha, depois OTP se o usuário tiver papel de equipe",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-username-password-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticatorFlow": true,
          "requirement": "CONDITIONAL",
          "priority": 20,
          "flowAlias": "mfa-operator",
          "userSetupAllowed": false
        },
        {
          "authenticatorFlow": true,
          "requirement": "CONDITIONAL",
          "priority": 30,
          "flowAlias": "mfa-company-admin",
          "userSetupAllowed": false
        },
        {
          "authenticatorFlow": true,
          "requirement": "CONDITIONAL",
          "priority": 40,
          "flowAlias": "mfa-platform-admin",
          "userSetupAllowed": false
        },
        {
          "authenticatorFlow": true,
          "requirement": "CONDITIONAL",
          "priority": 50,
          "flowAlias": "mfa-condo-manager",
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "mfa-operator",
      "description": "OTP obrigatório para o papel operator",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-user-role",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticatorConfig": "cond-role-operator"
        },
        {
          "authenticator": "auth-otp-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "mfa-company-admin",
      "description": "OTP obrigatório para o papel company-admin",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-user-role",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticatorConfig": "cond-role-company-admin"
        },
        {
          "authenticator": "auth-otp-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "mfa-platform-admin",
      "description": "OTP obrigatório para o papel platform-admin",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-user-role",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticatorConfig": "cond-role-platform-admin"
        },
        {
          "authenticator": "auth-otp-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "mfa-condo-manager",
      "description": "OTP obrigatório para o papel condo-manager",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-user-role",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticatorConfig": "cond-role-condo-manager"
        },
        {
          "authenticator": "auth-otp-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false
        }
      ]
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "cond-role-operator",
      "config": {
        "condUserRole": "operator",
        "negate": "false"
      }
    },
    {
      "alias": "cond-role-company-admin",
      "config": {
        "condUserRole": "company-admin",
        "negate": "false"
      }
    },
    {
      "alias": "cond-role-platform-admin",
      "config": {
        "condUserRole": "platform-admin",
        "negate": "false"
      }
    },
    {
      "alias": "cond-role-condo-manager",
      "config": {
        "condUserRole": "condo-manager",
        "negate": "false"
      }
    }
  ],
  "eventsEnabled": true,
  "eventsExpiration": 2592000,
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": false,
  "enabledEventTypes": [
    "LOGIN",
    "LOGIN_ERROR",
    "LOGOUT",
    "UPDATE_TOTP",
    "REMOVE_TOTP",
    "UPDATE_PASSWORD",
    "RESET_PASSWORD",
    "CODE_TO_TOKEN_ERROR",
    "REFRESH_TOKEN_ERROR"
  ]
}